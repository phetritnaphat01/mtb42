rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /disbursements/{document=**} {
      allow read, write: if true;
    }
    match /app_config/{document=**} {
      allow read, write: if true;
    }
    match /users/{document=**} {
      allow read, write: if true;
    }
    match /login_history/{document=**} {
      allow read, write: if true;
    }
  }
}

